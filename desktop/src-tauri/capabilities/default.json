{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Main window: dialogs, scoped file access for .omni projects, opener for export folders",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:default",
    "opener:default",
    "fs:default",
    { "identifier": "fs:allow-read-file", "allow": [{ "path": "$DOCUMENT/**" }, { "path": "$HOME/**" }] },
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "$DOCUMENT/**" }, { "path": "$HOME/**" }] }
  ]
}
