{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OMNI-CELL",
  "version": "0.1.0",
  "identifier": "studio.omnicell.desktop",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OMNI-CELL",
        "label": "main",
        "width": 1600,
        "height": 1000,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0f0f0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' ws://127.0.0.1:* wss://*; font-src 'self'",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "icon": ["icons/icon.png"],
    "fileAssociations": [
      {
        "ext": ["omni"],
        "name": "OMNI-CELL project",
        "description": "Encrypted OMNI-CELL project",
        "mimeType": "application/x-omni-cell",
        "role": "Editor"
      }
    ],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
