{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "w3c-web-hid",
      "@webgpu/types"
    ],
    "noEmit": true,
    "paths": {
      "@omni/*": [
        "./web/src/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "web/src/**/*.ts",
    "web/test/**/*.ts",
    "server/**/*.ts",
    "web/app/**/*.ts"
  ]
}